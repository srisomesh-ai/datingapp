# Copy to your process environment (or a secrets manager) in production.
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=you@example.com

# Razorpay (UPI/cards). Without these, payments run in instant "mock" mode (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Money
PLATFORM_FEE_PERCENT=25
PACKAGE_VALIDITY_DAYS=90

# WebRTC. STUN servers (JSON) and an optional TURN relay (coturn with use-auth-secret).
# deploy/setup.sh sets the TURN values for you.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
TURN_URLS=turn:your-host:3478?transport=udp,turn:your-host:3478?transport=tcp
TURN_SECRET=same-value-as-static-auth-secret-in-turnserver.conf

# Storage
# DB_FILE=/var/data/app.db
# UPLOAD_DIR=/var/data/uploads
