# Copy to your process environment (or a secrets manager) in production.
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=you@example.com

# Razorpay (UPI/cards). Without these, payments run in instant "mock" mode (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Money
PLATFORM_FEE_PERCENT=25
PACKAGE_VALIDITY_DAYS=90

# WebRTC. Add a TURN server for users behind strict mobile/corporate NATs, e.g.:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Storage
# DB_FILE=/var/data/app.db
# UPLOAD_DIR=/var/data/uploads
